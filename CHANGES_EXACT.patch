+.progress>span{display:block;height:100%;background:linear-gradient(90deg,var(--teal),#31aab0);border-radius:inherit;width:0;transition:width .28s ease}
+.iconbtn{border:1px solid var(--line-strong);background:white;border-radius:11px;padding:9px 13px;color:var(--ink);font-weight:650;cursor:pointer;transition:border-color .16s ease,background .16s ease,transform .16s ease;white-space:nowrap}
+.iconbtn:hover{border-color:#9fbbc4;background:#fbfdfd}
+.iconbtn:active,.cta:active{transform:translateY(1px)}
