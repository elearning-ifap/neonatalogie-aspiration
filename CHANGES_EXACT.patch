+.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--teal-dark);font-weight:800;text-transform:uppercase;letter-spacing:.105em;margin-bottom:10px}
+.eyebrow::before{content:"";width:18px;height:2px;background:var(--teal);border-radius:2px}
+.hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(330px,.82fr);gap:48px;align-items:center;min-height:min(630px,calc(100vh - 220px))}
+.hero h1{font-size:clamp(44px,5.1vw,66px);max-width:760px}
