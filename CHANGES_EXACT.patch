+.risk{counter-increment:risk;position:relative;border-top:2px solid #9ccbd0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);border-left:1px solid var(--line);border-radius:13px;padding:42px 14px 16px;background:#fbfcfc;min-height:132px;display:flex;align-items:flex-end;font-size:14.5px;line-height:1.35;font-weight:720;color:#284f61}
+.risk::before{content:"0" counter(risk);position:absolute;top:14px;left:14px;font-size:12px;letter-spacing:.08em;color:var(--teal-dark);font-weight:800}
