+.nav button[data-go]{position:relative;width:100%;border:0;background:transparent;color:#d7e6eb;text-align:left;padding:9px 11px 9px 14px;border-radius:10px;margin:1px 0;cursor:pointer;font-size:14px;transition:background .15s ease,color .15s ease,padding-left .15s ease}
+.nav button[data-go]::before{content:"";position:absolute;left:2px;top:50%;width:3px;height:16px;border-radius:4px;background:transparent;transform:translateY(-50%);transition:background .15s ease}
+.nav button[data-go]:hover:not(:disabled){background:rgba(255,255,255,.07);color:white}
