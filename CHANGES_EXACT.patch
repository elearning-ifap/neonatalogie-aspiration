+.brandtext{min-width:0}
+.service-label{font-size:11px;line-height:1.2;font-weight:750;letter-spacing:.115em;text-transform:uppercase;color:var(--teal);margin-bottom:4px}
+.coursetitle{font-size:18px;line-height:1.2;font-weight:720;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-.012em}
