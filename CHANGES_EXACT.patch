+.hero-panel::after{content:"";position:absolute;width:210px;height:210px;border-radius:50%;right:-70px;top:-90px;background:rgba(11,141,153,.07)}
+.hero-visual{width:100%;height:auto;display:block;position:relative;z-index:1}
+.hero-principle{position:relative;z-index:1;border-top:1px solid #d5e5e6;padding-top:16px}
+.hero-principle strong{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--teal-dark)}
+.hero-principle p{font-size:15px;line-height:1.5;margin:6px 0 0;color:#476877}
+.pillrow{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0 8px}
+.pill{display:inline-flex;align-items:center;background:#edf5f6;color:#315a6c;border:1px solid #dce9ec;padding:7px 11px;border-radius:999px;font-size:13px;font-weight:650}
+.cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--teal);color:white;border:1px solid var(--teal);border-radius:12px;padding:12px 18px;font-weight:750;cursor:pointer;box-shadow:0 7px 18px rgba(11,141,153,.16);transition:background .15s ease,border-color .15s ease,box-shadow .15s ease,transform .15s ease}
+.cta:hover{background:var(--teal-dark);border-color:var(--teal-dark);box-shadow:0 9px 20px rgba(11,141,153,.20)}
+.secondary{background:white;color:var(--ink);border-color:var(--line-strong);box-shadow:none}
+.secondary:hover{background:#f8fbfb;color:var(--ink);border-color:#a8c0c7}
+.danger{background:var(--red);border-color:var(--red);box-shadow:0 7px 18px rgba(183,73,73,.14)}
+.danger:hover{background:#9f3d3d;border-color:#9f3d3d}
+.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:20px}
+.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:20px}
